DEV_FE_PORT=3400
DEV_BE_PORT=3401

# Authentication password
CCV_AUTH_PASSWORD=your-secure-password-here

# Server hostname (use 0.0.0.0 to bind to all interfaces for remote access)
# HOSTNAME=localhost

# Supabase (optional - enables Clu session tracking)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Voice Mode (optional - enables voice chat with Clu)
# OPENAI_API_KEY=sk-...          # For Whisper STT
# ELEVENLABS_API_KEY=...          # For TTS
# ELEVENLABS_VOICE_ID=...         # Optional: custom voice ID
# ANTHROPIC_API_KEY=sk-ant-...    # For Claude responses
